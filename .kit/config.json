{
 "project": "Board",
 "language": {
  "talk": "en"
 },
 "board_url": "http://127.0.0.1:8765",
 "fields": {
  "author": "from",
  "owner": "owner",
  "clerk": "clerk",
  "reviewer": "reviewer",
  "post": "post_id",
  "reply_to": "reply_to",
  "created": "created_at",
  "later_flags": [
   "read",
   "read_at",
   "delivered"
  ],
  "later_stamps": [
   "read_at",
   "delivered_at",
   "arrived_at",
   "updated_at"
  ],
  "post_updated": "updated_at",
  "post_moved": "done_at",
  "review_kind": [
   "kind",
   "review"
  ]
 },
 "shell_buckets": [
  {
   "name": "Bash: git",
   "all": [
    "git (push|pull|commit|merge|log|status|fetch)"
   ]
  }
 ],
 "mirror": {
  "branch": "board-mirror",
  "path": "../board-board-mirror",
  "overlap_hours": 1
 },
 "kit": {
  "runtime": "local",
  "cli": "claude",
  "mode": "local",
  "artifact": {
   "url": "https://claude.ai/artifact/Ek79P6H3WTPJjJVYPe9rsf",
   "prefix": "repos/board/",
   "note": "this repo's board is attached to Harmonize's Artifact board (kit_repos/_index there): posts and comments live under repos/board/"
  },
  "talk_language": "English",
  "limits": {
   "message_chars": 200,
   "done_message_chars": 200,
   "chat_answer_chars": 600
  },
  "guard": {
   "never_add": [
    "*.keystore",
    "*.jks",
    "*.pem",
    ".env",
    "keystore.properties"
   ],
   "allow_add": []
  },
  "session_start_lines": [],
  "orchestrator": {
   "context_limit_k": 380
  },
  "review": {
   "auto": "all",
   "train_every": 4,
   "since": "2026-11-24"
  },
  "post_body_max": 1500,
  "clerk": {
   "wait_minutes": 5,
   "context_limit_k": 80
  },
  "roles": {
   "orchestrator": {
    "model": "inherit",
    "effort": "medium"
   },
   "clerk": {
    "model": "flash_lite",
    "effort": "low"
   },
   "part": {
    "model": "inherit",
    "effort": "medium"
   },
   "consultant": {
    "model": "pro",
    "effort": "medium"
   },
   "cards": {
    "model": "flash",
    "effort": "low"
   }
  },
  "autonomy": {
   "level": "full_auto",
   "auto_consultant": true,
   "auto_defaults": true,
   "carry_on": true,
   "park_tangents": true
  },
  "scope": "single",
  "palette": null,
  "funnel": true,
  "main_branch": "main",
  "trunk_push": true,
  "claude_cli_roles": {
   "clerk": {
    "model": "haiku"
   },
   "part": {
    "model": "inherit"
   },
   "consultant": {
    "model": "opus"
   },
   "cards": {
    "model": "haiku"
   }
  },
  "claude_permission_mode": "best",
  "setup": false,
  "parts": {
   "memory": true,
   "board": true,
   "clerk": true,
   "orchestrator": true
  },
  "survey": "skipped: the kit's own repo: testing the Claude Code CLI workflow on its own board",
  "cmd": "",
  "memory_dir": ".board/memory",
  "pinned_docs": [
   "AGENTS.md",
   "README.md"
  ],
  "github": "anlonlt/board",
  "consumers": [
   {
    "name": "harmonize",
    "github": "anlonlt/harmonize",
    "check": "python3 -I .kit/kit.py resume --role orchestrator"
   }
  ],
  "unified_hooks": "2026-11-24"
 }
}
