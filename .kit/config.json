 "fields": {
  "author": "from",
  "owner": "owner",
  "clerk": "clerk",
  "reviewer": "reviewer",
  "post": "post_id",
  "reply_to": "reply_to",
  "created": "created_at",
  "later_flags": [],
  "later_stamps": [
   "updated_at"
  ],
  "post_updated": "updated_at",
