{
  "kit-board": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -I ../.kit/hook.py agy SessionStart"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|invoke_subagent|edit_file|write_file|send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ../.kit/hook.py agy PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "send_message|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I ../.kit/hook.py agy PostToolUse"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -I ../.kit/hook.py agy PreInvocation"
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 -I ../.kit/hook.py agy PostInvocation"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -I ../.kit/hook.py agy Stop"
      }
    ]
  }
}
