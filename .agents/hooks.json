{
  "kit-board": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_session_start.py"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I hooks/kit/kit_guard.py"
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I hooks/kit/kit_guard.py"
          }
        ]
      },
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I hooks/kit/kit_memory_jit.py"
          }
        ]
      },
      {
        "matcher": "send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I hooks/kit/kit_say_it_once.py"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I hooks/kit/kit_brief_guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_stop.py"
      },
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_pre_compact.py"
      },
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_web_save.py"
      },
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_say_it_once.py"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "send_message|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I hooks/kit/kit_say_it_once.py"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I hooks/kit/kit_brief_guard.py"
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_say_it_once.py"
      },
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_board_typing.py"
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 -I hooks/kit/kit_say_it_once.py"
      }
    ]
  }
}
