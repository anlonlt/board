name: CI

on:
  push:
    branches: [main, agy-local]
  pull_request:
    branches: [main, agy-local]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Run all regression suites
        run: python3 scripts/run_all_tests.py
